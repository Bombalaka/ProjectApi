@model IEnumerable<ProductApi.Domain.Entities.Product>
@{
    ViewData["Title"] = "Product List";
}

<h2>Product List</h2>
<a asp-action="Create">+ Add Product</a>

<table>
    <thead>
        <tr>
            <th>ID</th><th>Name</th><th>Price</th><th>Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.Id</td>
            <td>@p.Name</td>
            <td>@p.Price.ToString("C")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@p.Id">Edit</a> |
                <a asp-action="Delete" asp-route-id="@p.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
<p>
    <a asp-action="Index" asp-controller="Home">Back to Home</a>